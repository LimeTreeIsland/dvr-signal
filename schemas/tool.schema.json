{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "version",
    "status",
    "enabled",
    "input_fields",
    "output_routes",
    "rule_ids",
    "storage",
    "transmit_answers",
    "requires_verified_contacts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "scaffold",
        "review",
        "active"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "input_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "storage": {
      "const": "memory_only"
    },
    "transmit_answers": {
      "const": false
    },
    "requires_verified_contacts": {
      "const": true
    }
  },
  "additionalProperties": false
}
