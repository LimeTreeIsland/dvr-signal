{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DVR Signal issue snapshot",
  "type": "object",
  "required": [
    "snapshot_id",
    "label",
    "period_start",
    "period_end",
    "created_at",
    "snapshot_type",
    "methodology_version",
    "source_registry_version",
    "source_ids",
    "indicators",
    "unresolved_outcomes"
  ],
  "properties": {
    "snapshot_type": {
      "enum": ["retrospective_reconstruction", "current_partial_period", "contemporaneous"]
    },
    "indicators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue_id",
          "comparison_key",
          "value",
          "display",
          "data_state",
          "source_ids"
        ]
      }
    }
  }
}
