{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "version",
    "jurisdiction",
    "authority_id",
    "citation",
    "url",
    "summary",
    "trigger_event",
    "required_inputs",
    "exceptions",
    "timeframe",
    "source_status",
    "source_checked_on",
    "review_status",
    "last_reviewed",
    "reviewer",
    "approval_reference",
    "enabled"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "jurisdiction": {
      "const": "US-WA"
    },
    "authority_id": {
      "type": "string",
      "minLength": 1
    },
    "citation": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "trigger_event": {
      "type": "string",
      "minLength": 1
    },
    "required_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "timeframe": {
      "type": [
        "object",
        "null"
      ]
    },
    "source_status": {
      "enum": [
        "pending",
        "live_text_checked",
        "snapshot_text_checked"
      ]
    },
    "source_checked_on": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_status": {
      "enum": [
        "pending_review",
        "approved",
        "retired"
      ]
    },
    "last_reviewed": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
