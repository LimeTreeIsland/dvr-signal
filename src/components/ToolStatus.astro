---
interface Props {
  state: "available" | "review" | "unavailable";
  title: string;
  message: string;
}

const { state, title, message } = Astro.props;
const label = {
  available: "Available",
  review: "Needs review",
  unavailable: "Not yet available",
}[state];
---

<section class:list={["tool-status", `tool-status--${state}`]} aria-labelledby="tool-status-title">
  <div class="status-label">
    <span class="status-dot" aria-hidden="true"></span>
    <span>{label}</span>
  </div>
  <h2 id="tool-status-title">{title}</h2>
  <p>{message}</p>
</section>

<style>
  .tool-status {
    padding: var(--space-6);
    border: 1px solid color-mix(in srgb, var(--color-neutral) 35%, transparent);
    border-inline-start-width: 0.45rem;
    border-radius: var(--radius);
    background: #fff;
  }

  .tool-status--available { border-inline-start-color: var(--color-healthy); }
  .tool-status--review { border-inline-start-color: var(--color-review); }
  .tool-status--unavailable { border-inline-start-color: var(--color-neutral); }

  .status-label {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    font-weight: 700;
  }

  .status-dot {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 999px;
    background: var(--color-neutral);
  }

  .tool-status--available .status-dot { background: var(--color-healthy); }
  .tool-status--review .status-dot { background: var(--color-review); }

  h2 {
    margin-block: var(--space-3) var(--space-2);
  }

  p {
    margin: 0;
  }
</style>
