---
interface Props {
  id: string;
  label: string;
  initialText?: string;
  filename?: string;
  helpText?: string;
}

const {
  id,
  label,
  initialText = "",
  filename = "dvr-signal-draft.txt",
  helpText = "Edit this draft before copying, printing, or saving it.",
} = Astro.props;
const helpId = `${id}-help`;
---

<section class="draft" data-editable-draft data-filename={filename}>
  <label for={id}>{label}</label>
  <p id={helpId} class="help">{helpText}</p>
  <textarea id={id} aria-describedby={helpId} rows="12">{initialText}</textarea>

  <div class="actions" aria-label="Draft actions">
    <button type="button" data-action="copy">Copy text</button>
    <button type="button" data-action="print">Print</button>
    <button type="button" data-action="save">Save .txt</button>
  </div>

  <p class="feedback" role="status" aria-live="polite"></p>
</section>

<script>
  const drafts = document.querySelectorAll<HTMLElement>("[data-editable-draft]");

  for (const draft of drafts) {
    const textarea = draft.querySelector<HTMLTextAreaElement>("textarea");
    const feedback = draft.querySelector<HTMLElement>(".feedback");
    const filename = draft.dataset.filename || "dvr-signal-draft.txt";

    if (!textarea || !feedback) continue;

    const setFeedback = (message: string) => {
      feedback.textContent = message;
    };

    draft.querySelector<HTMLButtonElement>('[data-action="copy"]')?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(textarea.value);
        setFeedback("Draft copied to your clipboard.");
      } catch {
        setFeedback("Copy did not work in this browser. Select the text and copy it manually.");
      }
    });

    draft.querySelector<HTMLButtonElement>('[data-action="print"]')?.addEventListener("click", () => {
      window.print();
    });

    draft.querySelector<HTMLButtonElement>('[data-action="save"]')?.addEventListener("click", () => {
      const blob = new Blob([textarea.value], { type: "text/plain;charset=utf-8" });
      const objectUrl = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = objectUrl;
      link.download = filename;
      link.click();
      URL.revokeObjectURL(objectUrl);
      setFeedback("Draft saved as a text file.");
    });
  }
</script>

<style>
  .draft {
    display: grid;
    gap: var(--space-3);
  }

  label {
    font-weight: 700;
  }

  .help,
  .feedback {
    margin: 0;
    color: var(--color-neutral);
    font-size: 0.95rem;
  }

  textarea {
    width: 100%;
    min-height: 16rem;
    resize: vertical;
    padding: var(--space-4);
    border: 2px solid color-mix(in srgb, var(--color-neutral) 50%, transparent);
    border-radius: var(--radius);
    background: #fff;
    color: var(--color-ink);
    font: inherit;
    line-height: 1.55;
  }

  textarea:focus-visible {
    border-color: var(--color-warning);
    outline: 3px solid color-mix(in srgb, var(--color-warning) 35%, transparent);
    outline-offset: 2px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  button {
    min-height: 2.75rem;
    padding: 0.65rem 0.9rem;
    border: 2px solid var(--color-ink);
    border-radius: 0.5rem;
    background: #fff;
    color: var(--color-ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  button:hover {
    background: color-mix(in srgb, var(--color-healthy) 18%, white);
  }

  @media print {
    .actions,
    .help,
    .feedback {
      display: none;
    }

    textarea {
      min-height: auto;
      border: 0;
      padding: 0;
      resize: none;
    }
  }
</style>
