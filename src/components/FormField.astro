---
interface Props {
  id: string;
  label: string;
  hint?: string;
  required?: boolean;
  type?: "text" | "date" | "email";
  name?: string;
  autocomplete?: string;
}

const {
  id,
  label,
  hint,
  required = false,
  type = "text",
  name = id,
  autocomplete,
} = Astro.props;
const hintId = hint ? `${id}-hint` : undefined;
---

<div class="field">
  <label for={id}>
    {label}
    {required && <span class="required" aria-hidden="true"> *</span>}
  </label>
  {hint && <p id={hintId} class="hint">{hint}</p>}
  <input
    id={id}
    name={name}
    type={type}
    required={required}
    aria-describedby={hintId}
    autocomplete={autocomplete}
  />
</div>

<style>
  .field {
    display: grid;
    gap: var(--space-2);
  }

  label {
    font-weight: 700;
  }

  .required {
    color: var(--color-serious);
  }

  .hint {
    margin: 0;
    color: var(--color-neutral);
    font-size: 0.95rem;
  }

  input {
    min-height: 2.9rem;
    width: 100%;
    padding: 0.7rem 0.8rem;
    border: 2px solid color-mix(in srgb, var(--color-neutral) 55%, transparent);
    border-radius: 0.5rem;
    background: #fff;
    color: var(--color-ink);
    font: inherit;
  }

  input:focus-visible {
    border-color: var(--color-warning);
    outline: 3px solid color-mix(in srgb, var(--color-warning) 35%, transparent);
    outline-offset: 2px;
  }

  input:user-invalid {
    border-color: var(--color-serious);
  }
</style>
