---
interface Props {
  id: string;
  label: string;
  hint?: string;
  required?: boolean;
  name?: string;
  rows?: number;
}

const {
  id,
  label,
  hint,
  required = false,
  name = id,
  rows = 5,
} = Astro.props;
const hintId = hint ? `${id}-hint` : undefined;
---

<div class="field">
  <label for={id}>
    {label}
    {required && <span class="required" aria-hidden="true"> *</span>}
  </label>
  {hint && <p id={hintId} class="hint">{hint}</p>}
  <textarea
    id={id}
    name={name}
    rows={rows}
    required={required}
    aria-describedby={hintId}
  ></textarea>
</div>

<style>
  .field {
    display: grid;
    gap: var(--space-2);
  }

  label {
    font-weight: 700;
  }

  .required {
    color: var(--color-serious);
  }

  .hint {
    margin: 0;
    color: var(--color-neutral);
    font-size: 0.95rem;
  }

  textarea {
    width: 100%;
    min-height: 8rem;
    resize: vertical;
    padding: 0.8rem;
    border: 2px solid color-mix(in srgb, var(--color-neutral) 55%, transparent);
    border-radius: 0.5rem;
    background: #fff;
    color: var(--color-ink);
    font: inherit;
    line-height: 1.55;
  }

  textarea:focus-visible {
    border-color: var(--color-warning);
    outline: 3px solid color-mix(in srgb, var(--color-warning) 35%, transparent);
    outline-offset: 2px;
  }

  textarea:user-invalid {
    border-color: var(--color-serious);
  }
</style>
