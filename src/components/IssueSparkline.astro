---
interface Point {
  period: string;
  value: number;
  display: string;
}

interface Props {
  label: string;
  points: Point[];
  comparable: boolean;
}

const { label, points, comparable } = Astro.props;
const usable = comparable && points.length >= 2;

let polyline = "";
if (usable) {
  const values = points.map((point) => point.value);
  const min = Math.min(...values);
  const max = Math.max(...values);
  const span = max - min;
  polyline = points
    .map((point, index) => {
      const x = points.length === 1 ? 50 : (index / (points.length - 1)) * 100;
      const y = span === 0 ? 50 : 88 - ((point.value - min) / span) * 76;
      return x.toFixed(2) + "," + y.toFixed(2);
    })
    .join(" ");
}

const description = usable
  ? label + ": " + points.map((point) => point.period + " " + point.display).join(", ")
  : label + ": comparable trend unavailable";
---

{usable ? (
  <figure class="sparkline">
    <svg viewBox="0 0 100 100" role="img" aria-label={description} preserveAspectRatio="none">
      <line x1="0" x2="100" y1="88" y2="88" class="guide" />
      <polyline points={polyline} class="trend-line" />
      {points.map((point, index) => {
        const values = points.map((item) => item.value);
        const min = Math.min(...values);
        const max = Math.max(...values);
        const span = max - min;
        const x = points.length === 1 ? 50 : (index / (points.length - 1)) * 100;
        const y = span === 0 ? 50 : 88 - ((point.value - min) / span) * 76;
        return <circle cx={x} cy={y} r="3.5" class="trend-dot"><title>{point.period + ": " + point.display}</title></circle>;
      })}
    </svg>
    <figcaption>{points.map((point) => point.display).join(" → ")}</figcaption>
  </figure>
) : (
  <p class="trend-unavailable">Comparable trend unavailable.</p>
)}

<style>
  .sparkline {
    display: grid;
    grid-template-columns: minmax(6rem, 10rem) minmax(0, 1fr);
    gap: var(--space-3);
    align-items: center;
    margin: 0;
  }

  svg {
    width: 100%;
    height: 2.8rem;
    overflow: visible;
  }

  .guide {
    stroke: color-mix(in srgb, var(--color-neutral) 35%, transparent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .trend-line {
    fill: none;
    stroke: var(--color-healthy);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .trend-dot {
    fill: var(--color-paper);
    stroke: var(--color-healthy);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  figcaption,
  .trend-unavailable {
    margin: 0;
    color: var(--color-neutral);
    font-size: 0.8rem;
  }

  @media (max-width: 34rem) {
    .sparkline {
      grid-template-columns: 1fr;
    }

    svg {
      max-width: 12rem;
    }
  }
</style>
