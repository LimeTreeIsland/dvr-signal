---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Private Delay Ledger — DVR Signal" description="Analyze documented DVR milestones locally without uploading case information.">
  <div class="container ledger">
    <header>
      <p class="eyebrow">Private participant analysis</p>
      <h1>Delay & milestone ledger</h1>
      <p class="hero-copy">Measure elapsed calendar days from eligibility, track counselor changes, distinguish agency replies from unresolved record requests, and measure when critical guidance first appears.</p>
      <p><strong>Privacy:</strong> This tool reads your JSON file in browser memory only. It does not upload, store, or publish your case data. The public issue-ranking indicators are separate.</p>
      <p><a href="/system-status/issue-ranking/">Return to system-wide Issue Ranking</a></p>
    </header>
    <section class="panel">
      <h2>Load timeline</h2>
      <label for="ledger-file">Choose a private JSON ledger</label>
      <input id="ledger-file" type="file" accept=".json,application/json" />
      <div class="buttons">
        <button id="sample" type="button">Fictional example</button>
        <button id="clear" type="button">Clear data</button>
        <button id="export" type="button" disabled>Export private summary</button>
      </div>
      <p id="notice" role="status" aria-live="polite">No ledger loaded.</p>
    </section>
    <section id="results" class="panel" hidden>
      <h2>Elapsed time</h2>
      <label for="as-of">As-of date</label>
      <input id="as-of" type="date" />
      <div class="metric-grid" aria-live="polite">
        <div><span>Days since eligibility</span><strong id="elapsed"></strong></div>
        <div><span>Days to first IPE</span><strong id="ipe"></strong></div>
        <div><span>Days to assessment synthesis</span><strong id="synthesis"></strong></div>
        <div><span>Days to recorded regulatory guidance</span><strong id="guidance"></strong></div>
        <div><span>Distinct named counselors</span><strong id="counselors"></strong></div>
        <div><span>Distinct named consultants</span><strong id="consultants"></strong></div>
        <div><span>Open correction/records requests</span><strong id="pending"></strong></div>
        <div><span>Reported assessment accuracy</span><strong id="accuracy"></strong></div>
      </div>
      <p><strong>Interpretation:</strong> These are elapsed calendar days, not legal deadlines or findings of misconduct. Counselor counts exclude interim transfers; estimate accuracy is participant-reported. Disputed historical records require source verification.</p>
      <h3>Milestones and evidence</h3>
      <div class="table-wrap"><table><thead><tr><th scope="col">Date</th><th scope="col">Event</th><th scope="col">Days from eligibility</th><th scope="col">Evidence classification</th><th scope="col">Status</th></tr></thead><tbody id="events"></tbody></table></div>
      <h3>Still-open request ages</h3>
      <div class="table-wrap"><table><thead><tr><th scope="col">Request</th><th scope="col">Days pending</th></tr></thead><tbody id="requests"></tbody></table></div>
    </section>
    <section class="panel">
      <h2>Import format</h2>
      <p>Save a local JSON file with version, exact eligibility date and event records. Optional: reported_assessment_accuracy_percent (0–100), person, source_note and resolved_date. Neither the sample nor the page includes actual participant records.</p>
      <pre><code>{
  "version": 1,
  "eligibility_date": "2024-01-15",
  "events": [
    {
      "date": "2024-04-01",
      "title": "Example request for records",
      "kind": "records_request",
      "status": "pending",
      "source_type": "participant_report"
    }
  ]
}</code></pre>
      <p>Kinds: counselor, interim_counselor, consultant, ipe_signed, assessment_synthesis, regulatory_guidance, correction_request, records_request, service, decision, other. Status: completed, pending or disputed. Source type: participant_report, agency_correspondence, original_document, adjudicated_finding or not_verified.</p>
    </section>
  </div>
</BaseLayout>
<script>
  import { calendarDays, summarizeLedger, validateLedger } from "../../lib/delay-ledger.mjs";
  const get = (id: string) => document.getElementById(id)!;
  const file = get("ledger-file") as HTMLInputElement;
  const date = get("as-of") as HTMLInputElement;
  const results = get("results");
  const notice = get("notice");
  const exportButton = get("export") as HTMLButtonElement;
  let ledger: ReturnType<typeof validateLedger> | null = null;
  const today = new Date();
  const pad = (n: number) => String(n).padStart(2, "0");
  date.value = [today.getFullYear(), pad(today.getMonth() + 1), pad(today.getDate())].join("-");
  function display(id: string, value: string) { get(id).textContent = value; }
  function appendRow(body: HTMLElement, columns: string[]) {
    const tr = document.createElement("tr");
    for (const value of columns) {
      const td = document.createElement("td"); td.textContent = value; tr.append(td);
    }
    body.append(tr);
  }
  function render() {
    if (!ledger) return;
    try {
      const report = summarizeLedger(ledger, date.value);
      results.hidden = false;
      exportButton.disabled = false;
      display("elapsed", report.elapsed_days === null ? "Before eligibility" : String(report.elapsed_days));
      display("ipe", report.first_ipe ? String(calendarDays(ledger.eligibility_date, report.first_ipe.date)) : "Not recorded");
      display("synthesis", report.first_synthesis ? String(calendarDays(ledger.eligibility_date, report.first_synthesis.date)) : "Not recorded");
      display("guidance", report.first_regulatory_guidance ? String(calendarDays(ledger.eligibility_date, report.first_regulatory_guidance.date)) : "Not recorded");
      display("counselors", String(report.counselor_count));
      display("consultants", String(report.consultant_count));
      display("pending", String(report.open_records_requests));
      display("accuracy", report.reported_accuracy_percent === null ? "Not supplied" : String(report.reported_accuracy_percent) + "% (reported)");
      const events = get("events"); const requests = get("requests");
      events.replaceChildren(); requests.replaceChildren();
      const visible = ledger.events.filter(e => calendarDays(e.date, date.value) !== null).sort((a, b) => a.date.localeCompare(b.date));
      for (const event of visible) {
        appendRow(events, [event.date, event.title, String(calendarDays(ledger.eligibility_date, event.date) ?? "Before eligibility"), event.source_type.replaceAll("_", " ") + (event.source_note ? " · " + event.source_note : ""), event.status]);
        if ((event.kind === "correction_request" || event.kind === "records_request") && event.status === "pending" && !event.resolved_date) {
          appendRow(requests, [event.title, String(calendarDays(event.date, date.value))]);
        }
      }
      if (!requests.children.length) appendRow(requests, ["No pending requests entered", "—"]);
      notice.textContent = "Local data loaded. No information was uploaded.";
    } catch (error) {
      notice.textContent = error instanceof Error ? error.message : "Invalid as-of date";
    }
  }
  file.addEventListener("change", async () => {
    try {
      const chosen = file.files?.[0]; if (!chosen) return;
      if (chosen.size > 200000) throw new Error("Ledger exceeds 200 KB.");
      ledger = validateLedger(JSON.parse(await chosen.text())); render();
    } catch (error) { notice.textContent = error instanceof Error ? error.message : "Import failed"; }
    finally { file.value = ""; }
  });
  get("sample").addEventListener("click", () => {
    ledger = validateLedger({ version: 1, eligibility_date: "2024-01-15", events: [
      { date: "2024-02-01", title: "Fictional counselor assigned", kind: "counselor", person: "Example A", status: "completed", source_type: "participant_report" },
      { date: "2024-06-20", title: "Fictional plan signed", kind: "ipe_signed", status: "completed", source_type: "original_document" },
      { date: "2024-09-02", title: "Fictional assessment synthesized", kind: "assessment_synthesis", status: "completed", source_type: "agency_correspondence" },
      { date: "2024-10-05", title: "Fictional correction request", kind: "correction_request", status: "pending", source_type: "participant_report" },
    ] }); render();
  });
  get("clear").addEventListener("click", () => {
    ledger = null; results.hidden = true; exportButton.disabled = true;
    get("events").replaceChildren(); get("requests").replaceChildren();
    notice.textContent = "Local timeline cleared from page memory.";
  });
  date.addEventListener("change", render);
  // Keep a loaded current-day clock accurate when the tab remains open overnight.
  // A manually selected historical as-of date is never overwritten.
  let automaticDate = date.value;
  window.setInterval(() => {
    const now = new Date();
    const currentDay = [now.getFullYear(), pad(now.getMonth() + 1), pad(now.getDate())].join("-");
    if (date.value === automaticDate && currentDay !== automaticDate) {
      date.value = currentDay;
      automaticDate = currentDay;
      render();
    }
  }, 60_000);
  exportButton.addEventListener("click", () => {
    if (!ledger) return;
    const summary = { caution: "Participant-entered elapsed-day calculation, not a legal finding.", as_of: date.value, ...summarizeLedger(ledger, date.value), events: ledger.events };
    const url = URL.createObjectURL(new Blob([JSON.stringify(summary, null, 2)], { type: "application/json" }));
    const anchor = document.createElement("a"); anchor.href = url; anchor.download = "private-dvr-delay-summary.json"; anchor.click();
    URL.revokeObjectURL(url);
  });
</script>
<style>
  .ledger { display: grid; gap: 1.5rem; }
  .ledger header { display: grid; gap: 1rem; }
  .ledger header h1 { font-size: clamp(2.4rem, 7vw, 4.5rem); margin: 0; }
  .ledger .panel { margin-block: 0; }
  .ledger label { display: block; font-weight: 700; }
  .ledger input, .ledger button { min-height: 2.75rem; font: inherit; }
  .ledger input { max-width: 100%; }
  .buttons { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1rem; }
  .buttons button { padding: .65rem 1rem; border: 1px solid var(--color-neutral); border-radius: .5rem; background: #fff; color: var(--color-ink); font-weight: 700; cursor: pointer; }
  .buttons button:disabled { opacity: .5; cursor: not-allowed; }
  .metric-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1rem; margin-block: 1.5rem; }
  .metric-grid div { display: grid; gap: .5rem; padding: 1rem; background: #fff; border-radius: .65rem; }
  .metric-grid span { font-size: .9rem; }
  .metric-grid strong { font-size: clamp(1.4rem, 3vw, 2.2rem); font-variant-numeric: tabular-nums; }
  .table-wrap, pre { overflow-x: auto; }
  table { width: 100%; min-width: 36rem; border-collapse: collapse; background: #fff; }
  td, th { padding: .75rem; text-align: left; border-bottom: 1px solid #d5d9da; vertical-align: top; }
  th { background: #e5e7e7; }
  pre { padding: 1.25rem; background: #121417; color: #f4f2ed; border-radius: .7rem; }
</style>
